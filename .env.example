# Bridge credentials. Copy to `.env` and fill in; never commit the result.
# `chmod 600 .env` after writing it.

# The credential the DeepSeek Harness presents to this bridge.
# Generate with: openssl rand -hex 32
BRIDGE_TOKEN=

# Rakazo's service-account token for the external computer surface.
# This must equal EXTERNAL_COMPUTER_TOKEN in the Rakazo deployment's .env.
RAKAZO_EXTERNAL_TOKEN=

# Where the Rakazo API listens.
RAKAZO_API_URL=http://127.0.0.1:3100

# Bind address and port for the bridge itself. Keep it on loopback unless the
# harness genuinely runs on another host.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=7400

# Optional: read credentials from a file other than `<repo>/.env`.
# BRIDGE_ENV_FILE=/etc/dsh-rakazo/bridge.env
